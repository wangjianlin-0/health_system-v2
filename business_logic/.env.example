# 环境变量配置

# 数据库
DATABASE_URL=sqlite:///./ecg_health.db

# JWT 密钥
SECRET_KEY=change-this-in-production

# AI 模型
AI_MODEL_PATH=./ai_model/models
AI_TIMEOUT=5
AI_FALLBACK_ENABLED=true

# 解释模型（不要把真实密钥提交到 Git）
ECG_MODEL_TYPE=openecg
ECG_EXPLANATION_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ECG_LLM_MODEL=deepseek-chat
ECG_LLM_ENDPOINT=https://api.deepseek.com
ECG_LLM_TIMEOUT=20

# 存储
DATA_STORAGE_PATH=./data/raw
MAX_FILE_SIZE_MB=50

# 日志
LOG_LEVEL=INFO
