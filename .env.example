# Copy to .env; install requirements-ai.txt before choosing openecg.
ECG_MODEL_TYPE=none

# External explanations use process environment variables.
# The explanation generator does not currently load these keys from .env.
ECG_EXPLANATION_PROVIDER=template
ECG_LLM_MODEL=deepseek-chat
ECG_LLM_TIMEOUT=10
DEEPSEEK_API_KEY=

# 记录任务与存储（可选，默认值即可本地开发）
# ECG_MAX_UPLOAD_BYTES=2000000
# ECG_MAX_SAMPLES=200000
# ECG_TASK_WORKERS=1
# ECG_TASK_LEASE_SECONDS=120
# ECG_HEARTBEAT_SECONDS=15
# ECG_RECOVERY_ON_START=1
# ECG_LOG_LEVEL=INFO
# 波形读取来源：auto（优先外置表）/table/payload
# ECG_SIGNAL_SOURCE=auto
# 访问审计保留天数，0 表示不清理
# ECG_AUDIT_RETENTION_DAYS=90
