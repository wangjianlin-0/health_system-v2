# Web upload/monitor selects cnn/hgb per task. This is the fallback for API clients.
# Use the shared CPU environment and requirements-pc.txt for cnn/hgb.
# OpenECG is optional and needs requirements-ai.txt.
ECG_MODEL_TYPE=cnn
# OpenECG长记录采用10秒窗口；默认每5秒滑动一次并合并节律事件。
ECG_RHYTHM_STEP_SECONDS=5

# 大模型只解释已有 JSON，不参与心拍或节律分类；失败时自动回退本地模板。
# template / deepseek / openai_compatible
ECG_EXPLANATION_PROVIDER=template
# deepseek 可不填 endpoint；其他 OpenAI 兼容服务填写到 /v1 或服务根路径。
# ECG_LLM_ENDPOINT=https://api.openai.com/v1
ECG_LLM_MODEL=deepseek-chat
ECG_LLM_TIMEOUT=10
DEEPSEEK_API_KEY=
# ECG_LLM_API_KEY=

# 记录任务与存储（可选，默认值即可本地开发）
# ECG_MAX_UPLOAD_BYTES=5000000
# ECG_MAX_SAMPLES=200000
# ECG_TASK_WORKERS=1
# ECG_TASK_LEASE_SECONDS=120
# ECG_HEARTBEAT_SECONDS=15
# ECG_RECOVERY_ON_START=1
# ECG_LOG_LEVEL=INFO
# 波形读取来源：auto（优先外置表）/table/payload
# ECG_SIGNAL_SOURCE=auto
# 访问审计保留天数，0 表示不清理
# ECG_AUDIT_RETENTION_DAYS=90
